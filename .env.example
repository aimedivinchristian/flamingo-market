# ───── Database (Neon: https://neon.tech) ─────
# Use the POOLED connection string here (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the DIRECT (non-pooled) string here — used by `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ───── Auth ─────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Local: http://localhost:3000   Production: https://your-domain.com (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ───── Email (Resend: https://resend.com) — signup OTP, password reset, order emails ─────
RESEND_API_KEY=""
# Must be an address on a domain you VERIFIED in Resend, e.g. "Flamingo Market <noreply@yourdomain.com>"
# For quick testing only: "Flamingo Market <onboarding@resend.dev>" (can ONLY deliver to your own Resend account email)
EMAIL_FROM="Flamingo Market <noreply@yourdomain.com>"
# Receives new-order alerts and contact-form messages
ADMIN_EMAIL=""

# ───── Images (Cloudinary: https://cloudinary.com) ─────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───── Seed (only used by `npm run db:seed`) ─────
ADMIN_PASSWORD=""        # min 8 chars; the admin email is ADMIN_EMAIL above
# SEED_DEMO="true"       # local dev only: creates demo seller/buyer accounts

# ───── Optional: Google sign-in ─────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───── Optional: Stripe card payments ─────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ───── Optional: MTN MoMo (sandbox by default) ─────
MOMO_ENV="sandbox"       # "production" for real money
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""

# ───── Optional: Telegram order alerts ─────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
